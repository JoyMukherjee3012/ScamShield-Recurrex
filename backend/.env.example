# Copy to backend/.env and fill in. Never commit the real .env file.

# Firebase Project Settings
FIREBASE_PROJECT_ID=angmi-8d81b
FIREBASE_SERVICE_ACCOUNT_PATH=

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Optional rate limits
SCAN_RATE_LIMIT_PER_MINUTE=30
REPORT_RATE_LIMIT_PER_HOUR=20
